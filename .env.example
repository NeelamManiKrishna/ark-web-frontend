# Base URL of the ARK backend API (no trailing slash).
# Leave empty to use same-origin requests (Vite dev server proxies /api to http://localhost:8080).
VITE_API_BASE_URL=

# Dev only: mock /auth/me, /auth/logout, /auth/logout-all and /auth/change-password
# until the backend ships them. Login and refresh still use the real backend.
VITE_USE_MOCK_AUTH=false
